### 访问日志配置
```typescript
// src/utils/access-logger.ts
interface AccessLogEntry {
  timestamp: Date;
  clientIP: string;
  method: string;
  path: string;
  statusCode: number;
  responseTime: number;
  userAgent: string;
  accessType: 'internal' | 'external' | 'admin';
  userId?: string;
}

class AccessLogger {
  logAccess(entry: AccessLogEntry) {
    const logMessage = {
      ...entry,
      timestamp: entry.timestamp.toISOString(),
      accessType: entry.accessType
    };

    // 记录到日志系统
    console.log(JSON.stringify(logMessage));
    
    // 发送到监控系统
    this.sendToMonitoring(entry);
  }

  private sendToMonitoring(entry: AccessLogEntry) {
    // 发送到Prometheus或其他监控系统
  }
}
```

### 网络监控指标
```typescript
// src/metrics/network-metrics.ts
interface NetworkMetrics {
  // 访问类型统计
  accessTypeCounter: {
    internal: number;
    external: number;
    admin: number;
  };
  
  // 响应时间统计
  responseTimeHistogram: {
    internal: number[];
    external: number[];
    admin: number[];
  };
  
  // 错误率统计
  errorRateCounter: {
    internal: number;
    external: number;
    admin: number;
  };
}

class NetworkMetricsCollector {
  private metrics: NetworkMetrics;

  constructor() {
    this.metrics = {
      accessTypeCounter: { internal: 0, external: 0, admin: 0 },
      responseTimeHistogram: { internal: [], external: [], admin: [] },
      errorRateCounter: { internal: 0, external: 0, admin: 0 }
    };
  }

  recordAccess(accessType: 'internal' | 'external' | 'admin', responseTime: number, isError: boolean) {
    this.metrics.accessTypeCounter[accessType]++;
    this.metrics.responseTimeHistogram[accessType].push(responseTime);
    
    if (isError) {
      this.metrics.errorRateCounter[accessType]++;
    }
  }

  getMetrics(): NetworkMetrics {
    return this.metrics;
  }
}
```

## 部署验证

### 网络连通性测试
```bash
#!/bin/bash
# scripts/test-network-access.sh

echo "测试网络访问配置..."

# 测试内部访问
echo "1. 测试内部访问..."
curl -H "Host: internal.keydesk.com" http://localhost/health
curl -H "Host: internal.keydesk.com" http://localhost/api/v1/health

# 测试外部访问
echo "2. 测试外部访问..."
curl -H "Host: api.keydesk.com" http://localhost/api/v1/activation-codes
curl -H "Host: api.keydesk.com" http://localhost/api/v1/templates

# 测试管理访问
echo "3. 测试管理访问..."
curl -H "Host: admin.keydesk.com" http://localhost/
curl -H "Host: admin.keydesk.com" http://localhost/dashboard

# 测试路径路由
echo "4. 测试路径路由..."
curl -H "Host: keydesk.com" http://localhost/api/v1/health
curl -H "Host: keydesk.com" http://localhost/internal/metrics
curl -H "Host: keydesk.com" http://localhost/admin/dashboard

echo "网络访问测试完成！"
```

