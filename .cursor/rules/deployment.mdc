```

## 部署脚本

### Kubernetes部署脚本
```bash
#!/bin/bash
# scripts/deploy-k8s.sh

set -e

# 配置变量
NAMESPACE="keydesk"
REGISTRY="your-registry.com"
VERSION="latest"

echo "开始部署KeyDesk到Kubernetes集群..."

# 创建命名空间
kubectl apply -f k8s/namespace.yaml

# 创建ConfigMap和Secret
kubectl apply -f k8s/configmap.yaml
kubectl apply -f k8s/secret.yaml

# 部署数据库
echo "部署MongoDB..."
kubectl apply -f k8s/database.yaml
kubectl wait --for=condition=ready pod -l app=keydesk-mongo -n $NAMESPACE --timeout=300s

echo "部署Redis..."
kubectl wait --for=condition=ready pod -l app=keydesk-redis -n $NAMESPACE --timeout=300s

# 部署微服务
echo "部署微服务..."
kubectl apply -f k8s/services.yaml

# 部署API Gateway
echo "部署API Gateway..."
kubectl apply -f k8s/api-gateway.yaml

# 部署Ingress
echo "部署Ingress..."
kubectl apply -f k8s/ingress.yaml

# 等待所有Pod就绪
echo "等待服务就绪..."
kubectl wait --for=condition=ready pod -l app=keydesk-api-gateway -n $NAMESPACE --timeout=300s

echo "部署完成！"
echo "API地址: https://api.keydesk.com"
echo "管理界面: https://admin.keydesk.com"

# 显示服务状态
kubectl get pods -n $NAMESPACE
kubectl get services -n $NAMESPACE
kubectl get ingress -n $NAMESPACE
```

### 单机部署脚本
```bash
#!/bin/bash
# scripts/deploy-standalone.sh

set -e

echo "开始单机部署KeyDesk..."

# 检查Docker和Docker Compose
if ! command -v docker &> /dev/null; then
    echo "错误: Docker未安装"
    exit 1
fi

if ! command -v docker-compose &> /dev/null; then
    echo "错误: Docker Compose未安装"
    exit 1
fi

# 创建环境变量文件
if [ ! -f .env ]; then
    echo "创建环境变量文件..."
    cat > .env << EOF
# 数据库配置
MONGODB_PASSWORD=your-mongodb-password
REDIS_PASSWORD=your-redis-password

# JWT配置
JWT_SECRET=your-jwt-secret-key

# Grafana配置
GRAFANA_PASSWORD=admin123

# 其他配置
NODE_ENV=production
EOF
    echo "请编辑.env文件配置密码和密钥"
    exit 1
fi

# 创建SSL证书（自签名）
if [ ! -f nginx/ssl/cert.pem ]; then
    echo "生成SSL证书..."
    mkdir -p nginx/ssl
    openssl req -x509 -nodes -days 365 -newkey rsa:2048 \
        -keyout nginx/ssl/key.pem \
        -out nginx/ssl/cert.pem \
        -subj "/C=CN/ST=State/L=City/O=Organization/CN=localhost"
fi

# 启动服务
echo "启动服务..."
docker-compose up -d

# 等待服务就绪
echo "等待服务就绪..."
sleep 30

# 检查服务状态
echo "检查服务状态..."
docker-compose ps

# 健康检查
echo "执行健康检查..."
curl -f http://localhost:8080/health || echo "健康检查失败"

echo "部署完成！"
echo "API地址: http://localhost:8080"
echo "HTTPS地址: https://localhost:8443"
echo "Grafana监控: http://localhost:3000"
echo "Prometheus: http://localhost:9090"
```

### 回滚脚本
```bash
#!/bin/bash
# scripts/rollback.sh

set -e

NAMESPACE="keydesk"
PREVIOUS_VERSION="v1.0.0"

echo "开始回滚到版本: $PREVIOUS_VERSION"

# 回滚部署
kubectl rollout undo deployment/keydesk-api-gateway -n $NAMESPACE
kubectl rollout undo deployment/keydesk-auth-service -n $NAMESPACE
kubectl rollout undo deployment/keydesk-code-service -n $NAMESPACE
kubectl rollout undo deployment/keydesk-template-service -n $NAMESPACE

# 等待回滚完成
echo "等待回滚完成..."
kubectl rollout status deployment/keydesk-api-gateway -n $NAMESPACE
kubectl rollout status deployment/keydesk-auth-service -n $NAMESPACE
kubectl rollout status deployment/keydesk-code-service -n $NAMESPACE
kubectl rollout status deployment/keydesk-template-service -n $NAMESPACE

echo "回滚完成！"
```

