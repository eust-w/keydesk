### 数据库部署
```yaml
# k8s/database.yaml
# MongoDB StatefulSet
apiVersion: apps/v1
kind: StatefulSet
metadata:
  name: keydesk-mongo
  namespace: keydesk
spec:
  serviceName: keydesk-mongo
  replicas: 3
  selector:
    matchLabels:
      app: keydesk-mongo
  template:
    metadata:
      labels:
        app: keydesk-mongo
    spec:
      containers:
      - name: mongo
        image: mongo:5.0
        ports:
        - containerPort: 27017
        env:
        - name: MONGO_INITDB_ROOT_USERNAME
          value: "admin"
        - name: MONGO_INITDB_ROOT_PASSWORD
          valueFrom:
            secretKeyRef:
              name: keydesk-secrets
              key: MONGODB_PASSWORD
        volumeMounts:
        - name: mongo-data
          mountPath: /data/db
        resources:
          requests:
            memory: "1Gi"
            cpu: "500m"
          limits:
            memory: "2Gi"
            cpu: "1000m"
  volumeClaimTemplates:
  - metadata:
      name: mongo-data
    spec:
      accessModes: ["ReadWriteOnce"]
      resources:
        requests:
          storage: 10Gi

---
# Redis StatefulSet
apiVersion: apps/v1
kind: StatefulSet
metadata:
  name: keydesk-redis
  namespace: keydesk
spec:
  serviceName: keydesk-redis
  replicas: 3
  selector:
    matchLabels:
      app: keydesk-redis
  template:
    metadata:
      labels:
        app: keydesk-redis
    spec:
      containers:
      - name: redis
        image: redis:6.2-alpine
        ports:
        - containerPort: 6379
        command: ["redis-server", "--requirepass", "$(REDIS_PASSWORD)"]
        env:
        - name: REDIS_PASSWORD
          valueFrom:
            secretKeyRef:
              name: keydesk-secrets
              key: REDIS_PASSWORD
        volumeMounts:
        - name: redis-data
          mountPath: /data
        resources:
          requests:
            memory: "256Mi"
            cpu: "100m"
          limits:
            memory: "512Mi"
            cpu: "200m"
  volumeClaimTemplates:
  - metadata:
      name: redis-data
    spec:
      accessModes: ["ReadWriteOnce"]
      resources:
        requests:
          storage: 5Gi
```

### Ingress配置
```yaml
# k8s/ingress.yaml
apiVersion: networking.k8s.io/v1
kind: Ingress
metadata:
  name: keydesk-ingress
  namespace: keydesk
  annotations:
    kubernetes.io/ingress.class: "nginx"
    nginx.ingress.kubernetes.io/ssl-redirect: "true"
    nginx.ingress.kubernetes.io/force-ssl-redirect: "true"
    nginx.ingress.kubernetes.io/proxy-body-size: "10m"
    nginx.ingress.kubernetes.io/rate-limit: "100"
    nginx.ingress.kubernetes.io/rate-limit-window: "1m"
spec:
  tls:
  - hosts:
    - api.keydesk.com
    - admin.keydesk.com
    secretName: keydesk-tls
  rules:
  - host: api.keydesk.com
    http:
      paths:
      - path: /
        pathType: Prefix
        backend:
          service:
            name: keydesk-api-gateway-service
            port:
              number: 80
  - host: admin.keydesk.com
    http:
      paths:
      - path: /
        pathType: Prefix
        backend:
          service:
            name: keydesk-admin-service
            port:
              number: 80
```

### 服务网格配置 (Istio)
```yaml
# k8s/istio-virtual-service.yaml
apiVersion: networking.istio.io/v1alpha3
kind: VirtualService
metadata:
  name: keydesk-vs
  namespace: keydesk
spec:
  hosts:
  - "api.keydesk.com"
  gateways:
  - keydesk-gateway
  http:
  - match:
    - uri:
        prefix: "/api/v1/auth"
    route:
    - destination:
        host: keydesk-auth-service
        port:
          number: 3000
  - match:
    - uri:
        prefix: "/api/v1/activation-codes"
    route:
    - destination:
        host: keydesk-code-service
        port:
          number: 3000
  - match:
    - uri:
        prefix: "/api/v1/templates"
    route:
    - destination:
        host: keydesk-template-service
        port:
          number: 3000
  - route:
    - destination:
        host: keydesk-api-gateway-service
        port:
          number: 80

---
apiVersion: networking.istio.io/v1alpha3
kind: Gateway
metadata:
  name: keydesk-gateway
  namespace: keydesk
spec:
  selector:
    istio: ingressgateway
  servers:
  - port:
      number: 80
      name: http
      protocol: HTTP
    hosts:
    - "api.keydesk.com"
    - "admin.keydesk.com"
  - port:
      number: 443
      name: https
      protocol: HTTPS
    tls:
      mode: SIMPLE
      credentialName: keydesk-tls
    hosts:
    - "api.keydesk.com"
    - "admin.keydesk.com"
```

## 单机部署

### Docker Compose配置
```yaml
# docker-compose.yml
version: '3.8'

services:
  # API Gateway
  api-gateway:
    image: keydesk/api-gateway:latest
    container_name: keydesk-api-gateway
    ports:
      - "80:80"
      - "443:443"
    environment:
      - NODE_ENV=production
      - REDIS_URL=redis://redis:6379
      - MONGODB_URL=mongodb://mongo:27017/keydesk
    depends_on:
      - redis
      - mongo
    networks:
      - keydesk-network
    restart: unless-stopped

  # Auth Service
  auth-service:
    image: keydesk/auth-service:latest
    container_name: keydesk-auth-service
    environment:
      - NODE_ENV=production
      - JWT_SECRET=${JWT_SECRET}
      - MONGODB_URL=mongodb://mongo:27017/keydesk
    depends_on:
      - mongo
    networks:
      - keydesk-network
    restart: unless-stopped

  # Code Service
  code-service:
    image: keydesk/code-service:latest
    container_name: keydesk-code-service
    environment:
      - NODE_ENV=production
      - MONGODB_URL=mongodb://mongo:27017/keydesk
      - REDIS_URL=redis://redis:6379
    depends_on:
      - mongo
      - redis
    networks:
      - keydesk-network
    restart: unless-stopped

  # Template Service
  template-service:
    image: keydesk/template-service:latest
    container_name: keydesk-template-service
    environment:
      - NODE_ENV=production
      - MONGODB_URL=mongodb://mongo:27017/keydesk
    depends_on:
      - mongo
    networks:
      - keydesk-network
    restart: unless-stopped

  # MongoDB
  mongo:
    image: mongo:5.0
    container_name: keydesk-mongo
    environment:
      - MONGO_INITDB_ROOT_USERNAME=admin
      - MONGO_INITDB_ROOT_PASSWORD=${MONGODB_PASSWORD}
    volumes:
      - mongo_data:/data/db
      - ./scripts/mongo-init.js:/docker-entrypoint-initdb.d/mongo-init.js:ro
    ports:
      - "27017:27017"
    networks:
      - keydesk-network
    restart: unless-stopped

  # Redis
  redis:
    image: redis:6.2-alpine
    container_name: keydesk-redis
    command: redis-server --requirepass ${REDIS_PASSWORD}
    volumes:
      - redis_data:/data
    ports:
      - "6379:6379"
    networks:
      - keydesk-network
    restart: unless-stopped

  # Nginx (Load Balancer)
  nginx:
    image: nginx:alpine
    container_name: keydesk-nginx
    ports:
      - "8080:80"
      - "8443:443"
    volumes:
      - ./nginx/nginx.conf:/etc/nginx/nginx.conf:ro
      - ./nginx/ssl:/etc/nginx/ssl:ro
    depends_on:
      - api-gateway
    networks:
      - keydesk-network
    restart: unless-stopped

  # Monitoring
  prometheus:
    image: prom/prometheus:latest
    container_name: keydesk-prometheus
    ports:
      - "9090:9090"
    volumes:
      - ./monitoring/prometheus.yml:/etc/prometheus/prometheus.yml:ro
      - prometheus_data:/prometheus
    networks:
      - keydesk-network
    restart: unless-stopped

  grafana:
    image: grafana/grafana:latest
    container_name: keydesk-grafana
    ports:
      - "3000:3000"
    environment:
      - GF_SECURITY_ADMIN_PASSWORD=${GRAFANA_PASSWORD}
    volumes:
      - grafana_data:/var/lib/grafana
    networks:
      - keydesk-network
    restart: unless-stopped

volumes:
  mongo_data:
  redis_data:
  prometheus_data:
  grafana_data:

networks:
  keydesk-network:
    driver: bridge
```

### Nginx配置
```nginx
# nginx/nginx.conf
events {
    worker_connections 1024;
}

http {
    upstream api_gateway {
        server api-gateway:80;
    }

    upstream auth_service {
        server auth-service:3000;
    }

    upstream code_service {
        server code-service:3000;
    }

    upstream template_service {
        server template-service:3000;
    }

    # 限流配置
    limit_req_zone $binary_remote_addr zone=api_limit:10m rate=10r/s;
    limit_req_zone $binary_remote_addr zone=auth_limit:10m rate=5r/s;

    server {
        listen 80;
        server_name localhost;

        # 健康检查
        location /health {
            access_log off;
            return 200 "healthy\n";
            add_header Content-Type text/plain;
        }

        # API路由
        location /api/v1/auth/ {
            limit_req zone=auth_limit burst=10 nodelay;
            proxy_pass http://auth_service/;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
        }

        location /api/v1/activation-codes/ {
            limit_req zone=api_limit burst=20 nodelay;
            proxy_pass http://code_service/;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
        }

        location /api/v1/templates/ {
            limit_req zone=api_limit burst=20 nodelay;
            proxy_pass http://template_service/;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
        }

        # 默认路由到API Gateway
        location / {
            limit_req zone=api_limit burst=20 nodelay;
            proxy_pass http://api_gateway;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
        }
    }

    server {
        listen 443 ssl http2;
        server_name localhost;

        ssl_certificate /etc/nginx/ssl/cert.pem;
        ssl_certificate_key /etc/nginx/ssl/key.pem;
        ssl_protocols TLSv1.2 TLSv1.3;
        ssl_ciphers ECDHE-RSA-AES256-GCM-SHA512:DHE-RSA-AES256-GCM-SHA512:ECDHE-RSA-AES256-GCM-SHA384:DHE-RSA-AES256-GCM-SHA384;
        ssl_prefer_server_ciphers off;

        # 与HTTP相同的location配置
        location /health {
            access_log off;
            return 200 "healthy\n";
            add_header Content-Type text/plain;
        }

        location /api/v1/auth/ {
            limit_req zone=auth_limit burst=10 nodelay;
            proxy_pass http://auth_service/;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
        }

        location /api/v1/activation-codes/ {
            limit_req zone=api_limit burst=20 nodelay;
            proxy_pass http://code_service/;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
        }

        location /api/v1/templates/ {
            limit_req zone=api_limit burst=20 nodelay;
            proxy_pass http://template_service/;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
        }

        location / {
            limit_req zone=api_limit burst=20 nodelay;
            proxy_pass http://api_gateway;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
        }
    }
}
```

## 网络访问配置

### 集群内访问
```yaml
# k8s/internal-service.yaml
apiVersion: v1
kind: Service
metadata:
  name: keydesk-internal
  namespace: keydesk
  labels:
    app: keydesk-internal
spec:
  selector:
    app: keydesk-api-gateway
  ports:
  - name: http
    port: 80
    targetPort: 80
  - name: https
    port: 443
    targetPort: 443
  type: ClusterIP
  # 集群内访问，不暴露到外部
```

### 集群外访问
```yaml
# k8s/external-service.yaml
apiVersion: v1
kind: Service
metadata:
  name: keydesk-external
  namespace: keydesk
  labels:
    app: keydesk-external
spec:
  selector:
    app: keydesk-api-gateway
  ports:
  - name: http
    port: 80
    targetPort: 80
  - name: https
    port: 443
    targetPort: 443
  type: LoadBalancer
  # 或者使用NodePort
  # type: NodePort
  # ports:
  # - name: http
  #   port: 80
  #   targetPort: 80
  #   nodePort: 30080
```

### 服务发现配置
```yaml
# k8s/service-discovery.yaml
