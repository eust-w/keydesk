## 安全配置

### 网络策略
```yaml
# k8s/network-policy.yaml
apiVersion: networking.k8s.io/v1
kind: NetworkPolicy
metadata:
  name: keydesk-network-policy
  namespace: keydesk
spec:
  podSelector:
    matchLabels:
      app: keydesk
  policyTypes:
  - Ingress
  - Egress
  ingress:
  - from:
    - namespaceSelector:
        matchLabels:
          name: ingress-nginx
    ports:
    - protocol: TCP
      port: 80
    - protocol: TCP
      port: 443
  - from:
    - podSelector:
        matchLabels:
          app: keydesk
    ports:
    - protocol: TCP
      port: 3000
  egress:
  - to:
    - podSelector:
        matchLabels:
          app: keydesk-mongo
    ports:
    - protocol: TCP
      port: 27017
  - to:
    - podSelector:
        matchLabels:
          app: keydesk-redis
    ports:
    - protocol: TCP
      port: 6379
  - to: []
    ports:
    - protocol: TCP
      port: 53
    - protocol: UDP
      port: 53
```

### RBAC配置
```yaml
# k8s/rbac.yaml
apiVersion: v1
kind: ServiceAccount
metadata:
  name: keydesk-service-account
  namespace: keydesk

---
apiVersion: rbac.authorization.k8s.io/v1
kind: Role
metadata:
  name: keydesk-role
  namespace: keydesk
rules:
- apiGroups: [""]
  resources: ["pods", "services", "endpoints"]
  verbs: ["get", "list", "watch"]
- apiGroups: [""]
  resources: ["configmaps", "secrets"]
  verbs: ["get"]

---
apiVersion: rbac.authorization.k8s.io/v1
kind: RoleBinding
metadata:
  name: keydesk-role-binding
  namespace: keydesk
subjects:
- kind: ServiceAccount
  name: keydesk-service-account
  namespace: keydesk
roleRef:
  kind: Role
  name: keydesk-role
  apiGroup: rbac.authorization.k8s.io
