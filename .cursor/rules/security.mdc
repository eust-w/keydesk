## 漏洞防护

### 常见漏洞防护
```typescript
interface VulnerabilityProtection {
  // SQL注入防护
  preventSQLInjection(query: string, params: any[]): string;
  
  // XSS防护
  preventXSS(input: string): string;
  
  // CSRF防护
  preventCSRF(token: string): boolean;
  
  // 路径遍历防护
  preventPathTraversal(path: string): string;
  
  // 命令注入防护
  preventCommandInjection(command: string): string;
}

class SecurityProtection {
  preventSQLInjection(query: string, params: any[]): string {
    // 使用参数化查询
    return query.replace(/\?/g, () => {
      const param = params.shift();
      return typeof param === 'string' ? `'${param.replace(/'/g, "''")}'` : param;
    });
  }
  
  preventXSS(input: string): string {
    return input
      .replace(/&/g, '&amp;')
      .replace(/</g, '&lt;')
      .replace(/>/g, '&gt;')
      .replace(/"/g, '&quot;')
      .replace(/'/g, '&#x27;')
      .replace(/\//g, '&#x2F;');
  }
  
  preventPathTraversal(path: string): string {
    // 规范化路径
    const normalized = path.replace(/\.\./g, '').replace(/\/+/g, '/');
    return normalized.startsWith('/') ? normalized : '/' + normalized;
  }
}
```

