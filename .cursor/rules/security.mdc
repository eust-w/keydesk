  roles: {
    SUPER_ADMIN: ['*'];                    // 超级管理员
    ADMIN: ['code:read', 'code:write', 'template:read', 'template:write'];
    OPERATOR: ['code:read', 'code:validate', 'template:read'];
    VIEWER: ['code:read', 'template:read'];
