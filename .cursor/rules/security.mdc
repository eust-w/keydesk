## 数据安全

### 数据加密
```typescript
interface DataEncryption {
  // AES加密
  encryptAES(data: string, key: string): Promise<string>;
  decryptAES(encryptedData: string, key: string): Promise<string>;
  
  // RSA加密
  encryptRSA(data: string, publicKey: string): Promise<string>;
  decryptRSA(encryptedData: string, privateKey: string): Promise<string>;
  
  // 字段级加密
  encryptField(value: any, fieldType: string): Promise<string>;
  decryptField(encryptedValue: string, fieldType: string): Promise<any>;
}

// 敏感数据加密
class SensitiveDataEncryption {
  private readonly algorithm = 'aes-256-gcm';
  private readonly keyLength = 32;
  private readonly ivLength = 16;
  
  async encryptSensitiveData(data: any): Promise<string> {
    const key = await this.generateKey();
    const iv = crypto.randomBytes(this.ivLength);
    const cipher = crypto.createCipher(this.algorithm, key, iv);
    
    let encrypted = cipher.update(JSON.stringify(data), 'utf8', 'hex');
    encrypted += cipher.final('hex');
    
    const authTag = cipher.getAuthTag();
    
    return JSON.stringify({
      encrypted,
      iv: iv.toString('hex'),
      authTag: authTag.toString('hex')
    });
  }
  
  async decryptSensitiveData(encryptedData: string): Promise<any> {
    const { encrypted, iv, authTag } = JSON.parse(encryptedData);
    const key = await this.generateKey();
    
    const decipher = crypto.createDecipher(this.algorithm, key, Buffer.from(iv, 'hex'));
    decipher.setAuthTag(Buffer.from(authTag, 'hex'));
    
    let decrypted = decipher.update(encrypted, 'hex', 'utf8');
    decrypted += decipher.final('utf8');
    
    return JSON.parse(decrypted);
  }
}
```

### 数据脱敏
```typescript
interface DataMasking {
  // 激活码脱敏
  maskActivationCode(code: string): string;
  
  // 用户信息脱敏
  maskUserInfo(user: User): User;
  
  // 日志脱敏
  maskLogData(data: any): any;
  
  // 响应脱敏
  maskResponse(response: any, userRole: string): any;
}

class DataMaskingService {
  maskActivationCode(code: string): string {
    if (code.length <= 4) return '*'.repeat(code.length);
    return code.substring(0, 2) + '*'.repeat(code.length - 4) + code.substring(code.length - 2);
  }
  
  maskUserInfo(user: User): User {
    return {
      ...user,
      email: this.maskEmail(user.email),
      phone: this.maskPhone(user.phone),
      customFields: '[REDACTED]'
    };
  }
  
  private maskEmail(email: string): string {
    const [local, domain] = email.split('@');
    return local.substring(0, 2) + '*'.repeat(local.length - 2) + '@' + domain;
  }
  
  private maskPhone(phone: string): string {
    return phone.substring(0, 3) + '*'.repeat(phone.length - 5) + phone.substring(phone.length - 2);
  }
}
```

## 输入验证和安全

### 输入验证
```typescript
interface InputValidation {
  // 激活码格式验证
  validateCodeFormat(code: string): ValidationResult;
  
  // 模板验证
  validateTemplate(template: Template): ValidationResult;
  
  // 自定义字段验证
  validateCustomFields(fields: Record<string, any>, schema: CustomFieldSchema[]): ValidationResult;
  
  // SQL注入防护
  sanitizeSQLInput(input: string): string;
  
  // XSS防护
  sanitizeHTMLInput(input: string): string;
}

class SecurityValidator {
  validateCodeFormat(code: string): ValidationResult {
    // 检查长度
    if (code.length < 4 || code.length > 50) {
      return { isValid: false, error: '激活码长度必须在4-50字符之间' };
    }
    
    // 检查字符集
    if (!/^[A-Z0-9\-_]+$/i.test(code)) {
      return { isValid: false, error: '激活码只能包含字母、数字、连字符和下划线' };
    }
    
    // 检查重复字符
    if (/(.)\1{3,}/.test(code)) {
      return { isValid: false, error: '激活码不能包含连续4个相同字符' };
    }
    
    return { isValid: true };
  }
  
  sanitizeSQLInput(input: string): string {
    // 移除SQL注入字符
    return input.replace(/['";\\]/g, '');
  }
  
  sanitizeHTMLInput(input: string): string {
    // 移除HTML标签
    return input.replace(/<[^>]*>/g, '');
  }
}
```

### 请求频率限制
```typescript
interface RateLimiting {
  // 基于IP的限制
  limitByIP(ip: string, limit: number, window: number): Promise<boolean>;
  
  // 基于用户的限制
  limitByUser(userId: string, limit: number, window: number): Promise<boolean>;
  
  // 基于API密钥的限制
  limitByAPIKey(apiKey: string, limit: number, window: number): Promise<boolean>;
  
  // 滑动窗口限制
  slidingWindowLimit(key: string, limit: number, window: number): Promise<boolean>;
}

class RateLimiter {
  private redis: Redis;
  
  async limitByIP(ip: string, limit: number, window: number): Promise<boolean> {
    const key = `rate_limit:ip:${ip}`;
    const current = await this.redis.incr(key);
    
    if (current === 1) {
      await this.redis.expire(key, window);
    }
    
    return current <= limit;
  }
  
  async limitByUser(userId: string, limit: number, window: number): Promise<boolean> {
    const key = `rate_limit:user:${userId}`;
    const current = await this.redis.incr(key);
    
    if (current === 1) {
      await this.redis.expire(key, window);
    }
    
    return current <= limit;
  }
}
```

