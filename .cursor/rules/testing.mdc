### API集成测试
```typescript
describe('ActivationCode API Integration', () => {
  let app: Express;
  let db: Db;
  let testUser: User;

  beforeAll(async () => {
    app = createTestApp();
    db = await connectTestDatabase();
    testUser = await createTestUser();
  });

  afterAll(async () => {
    await db.close();
  });

  beforeEach(async () => {
    await db.collection('activation_codes').deleteMany({});
    await db.collection('templates').deleteMany({});
  });

  describe('POST /api/v1/activation-codes', () => {
    it('should create activation code with valid template', async () => {
      // Arrange
      const template = await createTestTemplate(db);
      const token = generateTestToken(testUser);

      // Act
      const response = await request(app)
        .post('/api/v1/activation-codes')
        .set('Authorization', `Bearer ${token}`)
        .send({
          templateId: template.id,
          customFields: { userId: 'user-123' }
        })
        .expect(201);

      // Assert
      expect(response.body.success).toBe(true);
      expect(response.body.data.code).toMatch(/^[A-Z0-9]{8}$/);
      expect(response.body.data.templateId).toBe(template.id);
      
      // Verify database
      const savedCode = await db.collection('activation_codes').findOne({ _id: new ObjectId(response.body.data.id) });
      expect(savedCode).toBeDefined();
      expect(savedCode.status).toBe('active');
    });

    it('should return 400 for invalid template', async () => {
      // Arrange
      const token = generateTestToken(testUser);

      // Act
      const response = await request(app)
        .post('/api/v1/activation-codes')
        .set('Authorization', `Bearer ${token}`)
        .send({
          templateId: 'invalid-template-id',
          customFields: { userId: 'user-123' }
        })
        .expect(400);

      // Assert
      expect(response.body.success).toBe(false);
      expect(response.body.error.code).toBe('TEMPLATE_NOT_FOUND');
    });

    it('should return 401 without authentication', async () => {
      // Act
      await request(app)
        .post('/api/v1/activation-codes')
        .send({
          templateId: 'template-id',
          customFields: { userId: 'user-123' }
        })
        .expect(401);
    });
  });

  describe('POST /api/v1/activation-codes/validate', () => {
    it('should validate existing activation code', async () => {
      // Arrange
      const template = await createTestTemplate(db);
      const code = await createTestActivationCode(db, template.id);
      const token = generateTestToken(testUser);

      // Act
      const response = await request(app)
        .post('/api/v1/activation-codes/validate')
        .set('Authorization', `Bearer ${token}`)
        .send({ code: code.code })
        .expect(200);

      // Assert
      expect(response.body.success).toBe(true);
      expect(response.body.data.isValid).toBe(true);
    });

    it('should return invalid for non-existent code', async () => {
      // Arrange
      const token = generateTestToken(testUser);

      // Act
      const response = await request(app)
        .post('/api/v1/activation-codes/validate')
        .set('Authorization', `Bearer ${token}`)
        .send({ code: 'INVALID123' })
        .expect(200);

      // Assert
      expect(response.body.success).toBe(true);
      expect(response.body.data.isValid).toBe(false);
      expect(response.body.data.reason).toBe('激活码不存在');
    });
  });

  describe('GET /api/v1/activation-codes', () => {
    it('should return paginated activation codes', async () => {
      // Arrange
      const template = await createTestTemplate(db);
      await createTestActivationCodes(db, template.id, 15);
      const token = generateTestToken(testUser);

      // Act
      const response = await request(app)
        .get('/api/v1/activation-codes?page=1&limit=10')
        .set('Authorization', `Bearer ${token}`)
        .expect(200);

      // Assert
      expect(response.body.success).toBe(true);
      expect(response.body.data.items).toHaveLength(10);
      expect(response.body.data.pagination.total).toBe(15);
      expect(response.body.data.pagination.page).toBe(1);
      expect(response.body.data.pagination.limit).toBe(10);
    });

    it('should filter by template', async () => {
      // Arrange
      const template1 = await createTestTemplate(db, { name: 'Template 1' });
      const template2 = await createTestTemplate(db, { name: 'Template 2' });
      await createTestActivationCode(db, template1.id);
      await createTestActivationCode(db, template2.id);
      const token = generateTestToken(testUser);

      // Act
      const response = await request(app)
        .get(`/api/v1/activation-codes?templateId=${template1.id}`)
        .set('Authorization', `Bearer ${token}`)
        .expect(200);

      // Assert
      expect(response.body.data.items).toHaveLength(1);
      expect(response.body.data.items[0].templateId).toBe(template1.id);
    });
  });
});
