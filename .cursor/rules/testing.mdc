      const retrievedCode = await repository.findById(savedCode.id);

      // Assert
      expect(retrievedCode).toBeDefined();
      expect(retrievedCode!.code).toBe(code.code);
      expect(retrievedCode!.templateId).toBe(code.templateId);
    });

    it('should find codes by template', async () => {
      // Arrange
      const templateId = 'template-123';
      const codes = [
        createMockActivationCode({ templateId }),
        createMockActivationCode({ templateId }),
        createMockActivationCode({ templateId: 'other-template' })
      ];
      
      for (const code of codes) {
        await repository.save(code);
      }

      // Act
      const foundCodes = await repository.findByTemplate(templateId);

      // Assert
      expect(foundCodes).toHaveLength(2);
      expect(foundCodes.every(code => code.templateId === templateId)).toBe(true);
    });

    it('should update activation code', async () => {
      // Arrange
      const code = await repository.save(createMockActivationCode());
