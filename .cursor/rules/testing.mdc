## 性能测试

### 负载测试
```typescript
describe('Performance Tests', () => {
  let app: Express;

  beforeAll(async () => {
    app = createTestApp();
  });

  describe('Activation Code Generation', () => {
    it('should handle concurrent code generation', async () => {
      // Arrange
      const template = await createTestTemplate();
      const concurrentRequests = 100;
      const promises = [];

      // Act
      for (let i = 0; i < concurrentRequests; i++) {
        promises.push(
          request(app)
            .post('/api/v1/activation-codes')
            .set('Authorization', `Bearer ${generateTestToken()}`)
            .send({ templateId: template.id })
        );
      }

      const startTime = Date.now();
      const responses = await Promise.all(promises);
      const endTime = Date.now();

      // Assert
      expect(responses.every(r => r.status === 201)).toBe(true);
      expect(endTime - startTime).toBeLessThan(5000); // 5秒内完成
      
      // 验证所有生成的代码都是唯一的
      const codes = responses.map(r => r.body.data.code);
      expect(new Set(codes).size).toBe(concurrentRequests);
    });

    it('should handle bulk code generation efficiently', async () => {
      // Arrange
      const template = await createTestTemplate();
      const batchSize = 1000;

      // Act
      const startTime = Date.now();
      const response = await request(app)
        .post('/api/v1/activation-codes/batch')
        .set('Authorization', `Bearer ${generateTestToken()}`)
        .send({
          templateId: template.id,
          quantity: batchSize
        });
      const endTime = Date.now();

      // Assert
      expect(response.status).toBe(201);
      expect(response.body.data.codes).toHaveLength(batchSize);
      expect(endTime - startTime).toBeLessThan(10000); // 10秒内完成
    });
  });

  describe('Code Validation', () => {
    it('should handle high-frequency validation requests', async () => {
      // Arrange
      const template = await createTestTemplate();
      const codes = await createTestActivationCodes(100);
      const validationRequests = 1000;
      const promises = [];

      // Act
      for (let i = 0; i < validationRequests; i++) {
        const randomCode = codes[Math.floor(Math.random() * codes.length)];
        promises.push(
          request(app)
            .post('/api/v1/activation-codes/validate')
            .set('Authorization', `Bearer ${generateTestToken()}`)
            .send({ code: randomCode.code })
        );
      }

      const startTime = Date.now();
      const responses = await Promise.all(promises);
      const endTime = Date.now();

      // Assert
      expect(responses.every(r => r.status === 200)).toBe(true);
      expect(endTime - startTime).toBeLessThan(3000); // 3秒内完成
    });
  });
});
```

