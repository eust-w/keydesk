      const invalidData = {
        name: '',
        codePattern: 'invalid-pattern'
      };

      // Act & Assert
      await expect(service.createTemplate(invalidData))
        .rejects
        .toThrow('模板名称不能为空');
    });
  });

  describe('validateTemplate', () => {
    it('should validate code pattern', () => {
      // Valid patterns
      expect(service.validateCodePattern('[A-Z0-9]{8}')).toBe(true);
      expect(service.validateCodePattern('[A-Z]{4}-[0-9]{4}')).toBe(true);
      
      // Invalid patterns
      expect(service.validateCodePattern('')).toBe(false);
      expect(service.validateCodePattern('invalid')).toBe(false);
    });
