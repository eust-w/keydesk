// test/factories/activation-code.factory.ts
export class ActivationCodeFactory {
  static create(overrides: Partial<ActivationCode> = {}): ActivationCode {
    return {
      id: generateId(),
      code: generateRandomCode(),
      templateId: generateId(),
      customFields: {},
      status: 'active',
      usageCount: 0,
      maxUsage: 1,
      createdAt: new Date(),
      updatedAt: new Date(),
      ...overrides
    };
  }

  static createBatch(count: number, overrides: Partial<ActivationCode> = {}): ActivationCode[] {
    return Array.from({ length: count }, () => this.create(overrides));
  }
}

