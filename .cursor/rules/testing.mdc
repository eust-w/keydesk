      expect(result.codePattern).toBe(templateData.codePattern);
      expect(mockRepository.save).toHaveBeenCalledWith(
        expect.objectContaining({
          name: templateData.name,
          isActive: true
        })
      );
    });

    it('should validate template data', async () => {
