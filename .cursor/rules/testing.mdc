// test/helpers/database.helper.ts
export async function createTestDatabase(): Promise<Db> {
  const client = new MongoClient(process.env.TEST_MONGODB_URI || 'mongodb://localhost:27017/keydesk-test');
  await client.connect();
  return client.db();
}

export async function clearTestDatabase(db: Db): Promise<void> {
  const collections = await db.listCollections().toArray();
  for (const collection of collections) {
    await db.collection(collection.name).deleteMany({});
  }
}

// test/helpers/auth.helper.ts
export function generateTestToken(user: User = createTestUser()): string {
  return jwt.sign(
    { userId: user.id, username: user.username, roles: user.roles },
    process.env.JWT_SECRET || 'test-secret',
    { expiresIn: '1h' }
  );
}

// test/helpers/api.helper.ts
export async function createTestApp(): Promise<Express> {
  const app = express();
  app.use(express.json());
  app.use('/api/v1', apiRoutes);
  return app;
}
