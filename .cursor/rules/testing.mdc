### 激活码生成器测试
```typescript
describe('ActivationCodeGenerator', () => {
  let generator: ActivationCodeGenerator;
  let mockTemplate: Template;
  let mockRepository: jest.Mocked<ActivationCodeRepository>;

  beforeEach(() => {
    mockRepository = {
      findByCode: jest.fn(),
      save: jest.fn(),
      findById: jest.fn(),
      update: jest.fn(),
      delete: jest.fn()
    };
    
    generator = new ActivationCodeGenerator(mockRepository);
    mockTemplate = createMockTemplate();
  });

  describe('generate', () => {
    it('should generate unique activation code', async () => {
      // Arrange
      mockRepository.findByCode.mockResolvedValue(null);
      mockRepository.save.mockImplementation(async (code) => ({ ...code, id: 'generated-id' }));

      // Act
      const result = await generator.generate(mockTemplate);

      // Assert
      expect(result.code).toMatch(/^[A-Z0-9]{8}$/);
      expect(result.templateId).toBe(mockTemplate.id);
      expect(result.status).toBe('active');
      expect(mockRepository.save).toHaveBeenCalledWith(
        expect.objectContaining({
          code: expect.any(String),
          templateId: mockTemplate.id,
          status: 'active'
        })
      );
    });

    it('should retry when duplicate code is generated', async () => {
      // Arrange
      mockRepository.findByCode
        .mockResolvedValueOnce({ id: 'existing', code: 'ABC12345' } as ActivationCode)
        .mockResolvedValueOnce(null);
      mockRepository.save.mockImplementation(async (code) => ({ ...code, id: 'generated-id' }));

      // Act
      const result = await generator.generate(mockTemplate);

      // Assert
      expect(mockRepository.findByCode).toHaveBeenCalledTimes(2);
      expect(result.code).not.toBe('ABC12345');
    });

    it('should throw error after max retries', async () => {
      // Arrange
      mockRepository.findByCode.mockResolvedValue({ id: 'existing', code: 'ABC12345' } as ActivationCode);

      // Act & Assert
      await expect(generator.generate(mockTemplate))
        .rejects
        .toThrow('无法生成唯一激活码，请重试');
    });

    it('should validate template before generation', async () => {
      // Arrange
      const invalidTemplate = { ...mockTemplate, codePattern: '' };

      // Act & Assert
      await expect(generator.generate(invalidTemplate))
        .rejects
        .toThrow('模板格式无效');
    });
  });

  describe('generateBatch', () => {
    it('should generate multiple unique codes', async () => {
      // Arrange
      mockRepository.findByCode.mockResolvedValue(null);
      mockRepository.save.mockImplementation(async (code) => ({ ...code, id: `id-${Date.now()}` }));

      // Act
      const results = await generator.generateBatch(mockTemplate, 5);

      // Assert
      expect(results).toHaveLength(5);
      expect(results.every(code => code.templateId === mockTemplate.id)).toBe(true);
      expect(new Set(results.map(r => r.code)).size).toBe(5); // 所有代码都是唯一的
    });
  });
});
```

### 激活码验证器测试
```typescript
describe('ActivationCodeValidator', () => {
  let validator: ActivationCodeValidator;
  let mockRepository: jest.Mocked<ActivationCodeRepository>;

  beforeEach(() => {
    mockRepository = {
      findByCode: jest.fn(),
      save: jest.fn(),
      findById: jest.fn(),
      update: jest.fn(),
      delete: jest.fn()
    };
    
    validator = new ActivationCodeValidator(mockRepository);
  });

  describe('validate', () => {
    it('should return valid for active code', async () => {
      // Arrange
      const mockCode = createMockActivationCode({ status: 'active', usageCount: 0, maxUsage: 1 });
      mockRepository.findByCode.mockResolvedValue(mockCode);

      // Act
      const result = await validator.validate('ABC12345');

      // Assert
      expect(result.isValid).toBe(true);
      expect(result.code).toBe(mockCode);
      expect(result.reason).toBeUndefined();
    });

    it('should return invalid for non-existent code', async () => {
      // Arrange
      mockRepository.findByCode.mockResolvedValue(null);

      // Act
      const result = await validator.validate('INVALID');

      // Assert
      expect(result.isValid).toBe(false);
      expect(result.reason).toBe('激活码不存在');
    });

    it('should return invalid for expired code', async () => {
      // Arrange
      const expiredCode = createMockActivationCode({
        status: 'active',
        expiresAt: new Date(Date.now() - 1000) // 已过期
      });
      mockRepository.findByCode.mockResolvedValue(expiredCode);

      // Act
      const result = await validator.validate('ABC12345');

      // Assert
      expect(result.isValid).toBe(false);
      expect(result.reason).toBe('激活码已过期');
    });

    it('should return invalid for exceeded usage limit', async () => {
      // Arrange
      const overusedCode = createMockActivationCode({
        status: 'active',
        usageCount: 2,
        maxUsage: 1
      });
      mockRepository.findByCode.mockResolvedValue(overusedCode);

      // Act
      const result = await validator.validate('ABC12345');

      // Assert
      expect(result.isValid).toBe(false);
      expect(result.reason).toBe('激活码使用次数已达上限');
    });

    it('should return invalid for revoked code', async () => {
      // Arrange
      const revokedCode = createMockActivationCode({ status: 'revoked' });
      mockRepository.findByCode.mockResolvedValue(revokedCode);

      // Act
      const result = await validator.validate('ABC12345');

      // Assert
      expect(result.isValid).toBe(false);
      expect(result.reason).toBe('激活码已被撤销');
    });
  });

  describe('use', () => {
    it('should increment usage count and update status', async () => {
      // Arrange
      const mockCode = createMockActivationCode({
        status: 'active',
        usageCount: 0,
        maxUsage: 1
      });
      mockRepository.findByCode.mockResolvedValue(mockCode);
      mockRepository.update.mockResolvedValue(mockCode);

      // Act
      const result = await validator.use('ABC12345', { userId: 'user-123' });

      // Assert
      expect(result.success).toBe(true);
      expect(mockRepository.update).toHaveBeenCalledWith(
        mockCode.id,
        expect.objectContaining({
          usageCount: 1,
          status: 'used',
          lastUsedAt: expect.any(Date)
        })
      );
    });

    it('should not update status if usage count not reached max', async () => {
      // Arrange
      const mockCode = createMockActivationCode({
        status: 'active',
        usageCount: 0,
        maxUsage: 3
      });
      mockRepository.findByCode.mockResolvedValue(mockCode);
      mockRepository.update.mockResolvedValue(mockCode);

      // Act
      const result = await validator.use('ABC12345', { userId: 'user-123' });

      // Assert
      expect(result.success).toBe(true);
      expect(mockRepository.update).toHaveBeenCalledWith(
        mockCode.id,
        expect.objectContaining({
          usageCount: 1,
          status: 'active' // 状态保持active
        })
      );
    });
  });
});
```

