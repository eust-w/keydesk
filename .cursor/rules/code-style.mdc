### 文件命名
- 使用kebab-case命名文件
- 类文件使用PascalCase
- 测试文件以.test.ts或.spec.ts结尾
- 类型定义文件以.types.ts结尾

## 测试规范

### 单元测试
```typescript
describe('ActivationCodeGenerator', () => {
  let generator: ActivationCodeGenerator;
  let mockTemplate: Template;

  beforeEach(() => {
    generator = new ActivationCodeGenerator();
    mockTemplate = createMockTemplate();
  });

  describe('generate', () => {
    it('should generate valid activation code', async () => {
      // Arrange
      const expectedPattern = /^[A-Z0-9]{8}$/;

      // Act
      const result = await generator.generate(mockTemplate);

      // Assert
      expect(result.code).toMatch(expectedPattern);
      expect(result.templateId).toBe(mockTemplate.id);
      expect(result.status).toBe('active');
    });

    it('should throw error for invalid template', async () => {
      // Arrange
      const invalidTemplate = { ...mockTemplate, codePattern: '' };

      // Act & Assert
      await expect(generator.generate(invalidTemplate))
        .rejects
        .toThrow(ValidationError);
    });
  });
});
```

### 集成测试
```typescript
describe('ActivationCode API', () => {
  let app: Express;
  let db: Db;

  beforeAll(async () => {
    app = createTestApp();
    db = await connectTestDatabase();
  });

  afterAll(async () => {
    await db.close();
  });

  beforeEach(async () => {
    await db.collection('activation_codes').deleteMany({});
  });

  it('should create activation code', async () => {
    const response = await request(app)
      .post('/api/v1/activation-codes')
      .send({
        templateId: 'template-id',
        customFields: { userId: 'user-123' }
      })
      .expect(201);

    expect(response.body.success).toBe(true);
    expect(response.body.data.code).toBeDefined();
  });
});
```

## 性能规范

### 代码优化
```typescript
// 使用缓存
const codeCache = new Map<string, ActivationCode>();

const getCachedCode = async (id: string): Promise<ActivationCode | null> => {
  if (codeCache.has(id)) {
    return codeCache.get(id)!;
  }
  
  const code = await repository.findById(id);
  if (code) {
    codeCache.set(id, code);
  }
  return code;
};

// 使用批量操作
const batchUpdateStatus = async (ids: string[], status: ActivationCodeStatus): Promise<void> => {
  await repository.updateMany(
    { _id: { $in: ids } },
    { $set: { status, updatedAt: new Date() } }
  );
};

// 避免N+1查询
const getCodesWithTemplates = async (codes: ActivationCode[]): Promise<ActivationCodeWithTemplate[]> => {
  const templateIds = [...new Set(codes.map(c => c.templateId))];
  const templates = await templateRepository.findByIds(templateIds);
  const templateMap = new Map(templates.map(t => [t.id, t]));
  
  return codes.map(code => ({
    ...code,
    template: templateMap.get(code.templateId)
  }));
};
```

## 安全规范

### 输入验证
```typescript
// 使用验证库
import { z } from 'zod';

const CreateActivationCodeSchema = z.object({
  templateId: z.string().min(1, '模板ID不能为空'),
  customFields: z.record(z.any()).optional(),
  metadata: z.record(z.any()).optional()
});

const validateCreateRequest = (data: unknown) => {
  return CreateActivationCodeSchema.parse(data);
};
```

### 敏感数据处理
```typescript
// 加密敏感数据
import { encrypt, decrypt } from './crypto';

const saveSensitiveData = async (data: ActivationCode): Promise<void> => {
  const encryptedData = {
    ...data,
    customFields: encrypt(JSON.stringify(data.customFields))
  };
  await repository.save(encryptedData);
};

// 日志脱敏
const logActivationCode = (code: ActivationCode): void => {
  const sanitizedCode = {
    ...code,
    code: maskCode(code.code), // 脱敏处理
    customFields: '[REDACTED]'
  };
  logger.info('Activation code accessed', sanitizedCode);
};
```

